{
  "name": "mercury",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "node scripts/project.mjs build production",
    "dev": "node scripts/project.mjs dev",
    "check": "pnpm cf:types && vp check",
    "lint": "pnpm cf:types && vp lint",
    "typecheck": "pnpm cf:types && turbo typecheck",
    "test": "pnpm cf:types && node --test scripts/*.test.mjs && turbo test",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "db:generate": "pnpm --filter @workspace/api db:generate",
    "db:migrate": "node scripts/project.mjs migrate development",
    "prepare": "husky",
    "build:staging": "node scripts/project.mjs build staging",
    "preview": "pnpm --dir apps/web preview",
    "cf:types": "node scripts/project.mjs types production",
    "test:worker": "node scripts/verify-worker.mjs",
    "test:preview-transport": "node scripts/verify-preview-transport.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test:deployed": "node scripts/verify-deployed.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:migrate:staging": "node scripts/project.mjs migrate staging",
    "db:migrate:production": "node scripts/project.mjs migrate production",
    "deploy:staging": "node scripts/project.mjs deploy staging",
    "deploy:production": "node scripts/project.mjs deploy production"
  },
  "devDependencies": {
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6",
    "@playwright/test": "1.64.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite-plus": "catalog:",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "vp lint --fix --no-error-on-unmatched-pattern",
      "vp fmt --no-error-on-unmatched-pattern"
    ],
    "*.{css,json,md,yml,yaml}": "vp fmt --no-error-on-unmatched-pattern"
  }
}
