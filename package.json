{
  "name": "mercury",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "docker compose up -d --wait db && pnpm db:migrate && turbo dev",
    "dev:apps": "turbo dev",
    "check": "vp check",
    "lint": "vp lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "start": "turbo start",
    "prod": "docker compose --profile prod up --build --wait",
    "prod:down": "docker compose --profile prod down",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "db:studio": "turbo db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "vp lint --fix --no-error-on-unmatched-pattern",
      "vp fmt --no-error-on-unmatched-pattern"
    ],
    "*.{css,json,md,yml,yaml}": "vp fmt --no-error-on-unmatched-pattern"
  }
}
