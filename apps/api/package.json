    "test": "vp test run",
    "test:integration": "vp test run --config vite.integration.config.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.14",
    "zod": "^4.6.7",
    "pg": "8.23.1",
    "@neondatabase/auth": "0.6.0-beta"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite-plus": "catalog:",
    "@types/pg": "8.23.1"
  },
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
