{
  "name": "create-mercury",
  "version": "0.1.0",
  "description": "Create a Mercury project. An opinionated TypeScript full-stack starter with React, Hono, and PostgreSQL.",
  "keywords": [
    "create",
    "starter",
    "template",
    "react",
    "hono",
    "postgresql",
    "drizzle",
    "turborepo",
    "pnpm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arvemy/mercury.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/arvemy/mercury#readme",
  "type": "module",
  "bin": {
    "create-mercury": "dist/src/index.js"
  },
  "files": [
    "dist/src/index.js",
    "dist/src/scaffold.js",
    "template"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "snapshot": "node dist/scripts/snapshot.js",
    "prepack": "tsc -b && pnpm snapshot"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "eslint": "^10",
    "globals": "^17",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
